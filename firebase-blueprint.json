{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User profile storing authentication metadata and preferences",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "Unique identifier for the user"
        },
        "email": {
          "type": "string",
          "description": "User's email address"
        },
        "displayName": {
          "type": "string",
          "description": "User's full name"
        },
        "isGuest": {
          "type": "boolean",
          "description": "Whether the user is an anonymous guest"
        },
        "createdAt": {
          "type": "string",
          "description": "Account creation timestamp"
        }
      },
      "required": ["userId", "email", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "Collection of registered user accounts and profiles"
    }
  }
}
